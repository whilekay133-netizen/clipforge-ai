# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Auth, Postgres, Storage) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Anthropic Claude (scripts, scene plans, prompt enhancement) ----------
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# ---------- fal.ai (scene video, voiceover, subtitle timing, final composition) ----------
FAL_KEY=
# Optional overrides (must exist on fal.ai)
FAL_TEXT_TO_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
FAL_COMPOSE_MODEL=fal-ai/ffmpeg-api/compose

# Voiceover (Kokoro TTS) and subtitle timing (Whisper) also run on FAL_KEY — no extra key needed.

# ---------- Paystack (payments) ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------- Inngest (durable background workflows) ----------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Later stages (leave empty until integrated) ----------
RESEND_API_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# ---------- Free video backend (Pexels stock footage + GitHub Actions render) ----------
# Used automatically when FAL_KEY is empty. Force one with VIDEO_BACKEND=stock | fal.
VIDEO_BACKEND=
PEXELS_API_KEY=
# Fine-grained GitHub token with "Actions: Read and write" on the repo (starts the render workflow)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=whilekay133-netizen/clipforge-ai
GITHUB_RENDER_WORKFLOW=render.yml
GITHUB_RENDER_REF=main
# The workflow itself needs two repository secrets: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
